# B1-RU F-11 限时价到期批量下价（D1-B 裁定 2026-10-26；oneshot，由同名 .timer 周期触发）
# 容器交付形态：经 docker compose exec 在 backend 容器内执行（宿主机无 venv——
# 2026-10-26 走查修正；安装：见本目录 README.md；路径按交付实际调整，默认 /opt/b1ru）
[Unit]
Description=B1-RU F-11 deactivate expired prices (oneshot, via docker compose)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/b1ru/deploy
# -T：cron/systemd 无 tty 必需；exec 本身会插值 env，须带 --env-file（README 统一约定）
ExecStart=/usr/bin/docker compose --env-file /opt/b1ru/deploy/b1ru.env exec -T backend \
    python manage.py deactivate_expired_prices --quiet
# docker compose exec 需要 docker 权限：root 或将执行用户加入 docker 组
User=root
