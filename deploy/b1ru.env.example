# B1-RU 生产环境变量模板：复制为 b1ru.env 并填写；b1ru.env 不入库（.gitignore）
# fail-safe 纪律：DJANGO_ENV=production 时缺任一关键项，容器拒绝启动（config/settings.py）

DJANGO_SECRET_KEY=请生成48+位随机串
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# 数据库（compose 内网自连 db 服务；仅 PGPASSWORD 必改）
PGDATABASE=b1ru
PGUSER=b1ru
PGPASSWORD=请设置数据库口令

# 对外端口
B1RU_PORT=8000

# gunicorn 工作进程数（小实例 2-3 足够）
GUNICORN_WORKERS=3

# 可选：容器首启自动建运维超管（两值都设才生效；建后建议入 owner 组或改密，README §2/§3）
# DJANGO_SUPERUSER_USERNAME=ops
# DJANGO_SUPERUSER_PASSWORD=请设置强口令
# DJANGO_SUPERUSER_EMAIL=ops@example.com

# 可选：离线 license 文件路径（D3-A；缺省 /app/license.json，缺失仅提示不锁功能）
# B1RU_LICENSE_FILE=/data/license.json
